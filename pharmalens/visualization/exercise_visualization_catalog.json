{
  "version": "0.2",
  "name": "PharmaLens Visualization Catalog",
  "principle": "One reusable visualization engine; each exercise declares a presentation pack.",
  "packs": {
    "market_intelligence": {"kpis":["market_value","market_units","growth_pct","market_share_pct","brand_count"],"visuals":[["market_trend","line","Market value trend"],["company_share","horizontal_bar","Company market share"],["brand_ranking","horizontal_bar","Top brands by value"],["therapeutic_mix","treemap","Therapeutic class mix"],["price_vs_growth","scatter","Price vs growth"],["competitive_landscape","scatter","Competitive landscape"]],"insights":["market_growth","share_shift","concentration","opportunity"],"exports":["png","svg","pdf","pptx","xlsx","csv"]},
    "forecasting": {"kpis":["actual_value","forecast_value","forecast_error_pct","growth_pct"],"visuals":[["actual_vs_forecast","line","Actual vs forecast"],["forecast_error","bar","Forecast error by period"],["forecast_range","line","Forecast with confidence range"],["scenario_comparison","line","Base / upside / downside"]],"insights":["trend","accuracy","risk","scenario"],"exports":["png","svg","pdf","pptx","xlsx","csv"]},
    "gtm": {"kpis":["target_market_value","growth_pct","accessibility_score","competitive_intensity"],"visuals":[["segment_attractiveness","horizontal_bar","Segment attractiveness"],["market_attractiveness_vs_competition","scatter","Attractiveness vs competition"],["segment_mix","treemap","Segment opportunity mix"],["gtm_priority_matrix","scatter","GTM priority matrix"]],"insights":["priority_segments","white_space","competitive_pressure","execution_focus"],"exports":["png","svg","pdf","pptx","xlsx","csv"]},
    "launch": {"kpis":["launch_value","growth_pct","share_pct","time_to_peak"],"visuals":[["launch_ramp","line","Launch performance ramp"],["launch_cohort_comparison","line","Launch cohort comparison"],["launch_success_factors","horizontal_bar","Success factor contribution"],["launch_priority_matrix","scatter","Launch priority matrix"]],"insights":["ramp","benchmark","success_factors","risk"],"exports":["png","svg","pdf","pptx","xlsx"]},
    "pricing": {"kpis":["average_price","price_index","price_growth_pct","value_growth_pct"],"visuals":[["price_trend","line","Price trend"],["price_index_comparison","horizontal_bar","Price index comparison"],["price_vs_value_growth","scatter","Price vs value growth"],["price_waterfall","waterfall","Price bridge"]],"insights":["price_position","elasticity_signal","premium_opportunity","risk"],"exports":["png","svg","pdf","pptx","xlsx"]},
    "market_access": {"kpis":["eligible_population","access_rate_pct","reimbursement_rate_pct","access_gap_pct"],"visuals":[["access_by_segment","horizontal_bar","Access by segment"],["access_gap","bar","Access gap"],["reimbursement_mix","stacked_bar","Reimbursement mix"],["access_priority_matrix","scatter","Access priority matrix"]],"insights":["access_gap","reimbursement","priority","barrier"],"exports":["png","svg","pdf","pptx","xlsx"]},
    "heor": {"kpis":["total_cost","incremental_cost","incremental_effect","icer"],"visuals":[["cost_effectiveness","scatter","Cost-effectiveness plane"],["budget_impact","line","Budget impact"],["cost_breakdown","stacked_bar","Cost breakdown"],["scenario_comparison","bar","HEOR scenario comparison"]],"insights":["cost_effectiveness","budget_impact","drivers","scenario"],"exports":["png","svg","pdf","pptx","xlsx"]},
    "sfe": {"kpis":["achievement_pct","growth_pct","target_coverage_pct","productivity"],"visuals":[["rep_achievement","horizontal_bar","Rep achievement"],["monthly_achievement","line","Monthly achievement"],["territory_performance","horizontal_bar","Territory performance"],["target_vs_sales","scatter","Target vs sales"]],"insights":["performance","coverage","productivity","opportunity"],"exports":["png","svg","pdf","pptx","xlsx","csv"]},
    "kol": {"kpis":["kol_count","engagement_rate_pct","reach","priority_score"],"visuals":[["kol_priority","horizontal_bar","KOL priority"],["influence_vs_engagement","scatter","Influence vs engagement"],["specialty_mix","treemap","Specialty mix"],["kol_network","sankey","KOL network flow"]],"insights":["priority","coverage","engagement","network"],"exports":["png","svg","pdf","pptx","xlsx"]},
    "medical_affairs": {"kpis":["evidence_count","engagement_count","insight_count","coverage_pct"],"visuals":[["evidence_timeline","line","Evidence timeline"],["evidence_by_topic","horizontal_bar","Evidence by topic"],["medical_insight_mix","treemap","Medical insight mix"],["evidence_gap","bar","Evidence gap"]],"insights":["evidence_trend","coverage","gap","engagement"],"exports":["png","svg","pdf","pptx","xlsx"]},
    "supply_chain": {"kpis":["demand","supply","inventory","service_level_pct"],"visuals":[["supply_demand","line","Supply vs demand"],["inventory_trend","line","Inventory trend"],["service_level","bar","Service level"],["demand_supply_gap","bar","Demand-supply gap"]],"insights":["shortage","inventory","service","forecast_risk"],"exports":["png","svg","pdf","pptx","xlsx"]},
    "company_intelligence": {"kpis":["revenue","growth_pct","market_share_pct","portfolio_count"],"visuals":[["company_growth","line","Company growth"],["portfolio_mix","treemap","Portfolio mix"],["company_share","horizontal_bar","Company share"],["company_positioning","scatter","Company positioning"]],"insights":["growth","portfolio","share","position"],"exports":["png","svg","pdf","pptx","xlsx"]},
    "recommendations": {"kpis":["opportunity_count","high_priority_count","estimated_value","confidence_pct"],"visuals":[["opportunity_priority","horizontal_bar","Opportunity priority"],["impact_vs_effort","scatter","Impact vs effort"],["recommendation_mix","treemap","Recommendation mix"],["priority_matrix","scatter","Priority matrix"]],"insights":["priority","impact","effort","confidence"],"exports":["png","svg","pdf","pptx","xlsx"]}
  }
}
